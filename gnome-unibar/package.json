{
  "name": "gnome-unibar",
  "version": "1.0.0",
  "description": "GNOME Shell extension that moves the top bar to the bottom of the screen.",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec 'test/**/*.test.js'",
    "test:coverage": "c8 --config .c8rc.json node --test 'test/**/*.test.js'",
    "check": "npm run lint && npm run format:check && npm run test:coverage",
    "pack": "bash scripts/pack.sh",
    "install:local": "bash scripts/install.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "c8": "^10.1.3",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2"
  }
}
