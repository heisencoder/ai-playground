{
  "all": true,
  "include": ["src/lib/**/*.js"],
  "exclude": [
    "src/extension.js",
    "test/**",
    "coverage/**",
    "node_modules/**",
    "scripts/**",
    "*.config.js"
  ],
  "reporter": ["text", "text-summary", "lcov", "html"],
  "check-coverage": true,
  "lines": 90,
  "functions": 90,
  "branches": 90,
  "statements": 90,
  "clean": true
}
